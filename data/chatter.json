  },
  {
   "id": "L123",
   "hero": "P01",
   "kind": "say",
   "when": [
    "knows"
   ],
   "text": "Помню «{card}». Знание — оружие, которое не отнимешь."
  },
  {
   "id": "L124",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "knows"
