{
 "_doc": "Мысли и реплики героев над картами (ChatterRules). Генерируется tools/gen_chatter.py — не править руками.",
 "settings": {
  "every": [
   60,
   100
  ],
  "first": [
   8,
   14
  ],
  "poke_chance": 0.5,
  "recent": 40
 },
 "lines": [
  {
   "id": "L001",
   "hero": "*",
   "kind": "thought",
   "when": [
    "place"
   ],
   "text": "{place}. Запомнить, где здесь укрыться."
  },
  {
   "id": "L002",
   "hero": "P01",
   "kind": "say",
   "when": [
    "place"
   ],
   "text": "{place}. Ночевать здесь? Видал и хуже. Немного."
  },
  {
   "id": "L003",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "place"
   ],
   "text": "{place} звучит иначе, чем вчерашнее место. Тише… или осторожнее."
  },
  {
   "id": "L004",
   "hero": "P02",
   "kind": "say",
   "when": [
    "place"
   ],
   "text": "{place}. Осмотреться, выставить дозор — потом отдых."
  },
  {
   "id": "L005",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:sleep_edge"
   ],
   "text": "Грань сна. Ещё шаг — и проснусь. Или нет."
  },
  {
   "id": "L006",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:slave_caravan"
   ],
   "text": "Караван рабов. Честное место: каждый знает, чего он стоит."
  },
  {
   "id": "L007",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:fallen_caravan"
   ],
   "text": "Павший караван. Кто-то здесь тоже думал, что успеет."
  },
  {
   "id": "L008",
   "hero": "P08",
   "kind": "say",
   "when": [
    "at:kings_path"
   ],
   "text": "Тропа Горного Короля. Ступайте тихо — у королей чуткий сон."
  },
  {
   "id": "L009",
   "hero": "P10",
   "kind": "say",
   "when": [
    "at:broken_road"
   ],
   "text": "Разрушенная дорога? Отличное место, чтобы повернуть назад!"
  },
  {
   "id": "L010",
   "hero": "P09",
   "kind": "thought",
   "when": [
    "at:night_camp"
   ],
   "text": "Ночной привал. Считаю звёзды, чтобы не считать шансы."
  },
  {
   "id": "L011",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:shadow_temple"
   ],
   "text": "Храм Бога Теней. Почему кажется, что здесь ждали именно меня?"
  },
  {
   "id": "L012",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:medbay"
   ],
   "text": "Медицинское крыло. Пахнет хлоркой и чужими кошмарами."
  },
  {
   "id": "L013",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:gate"
   ],
   "text": "Ворота Академии. Здесь учат тому, чему Кошмар учит бесплатно."
  },
  {
   "id": "L014",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:dorm"
   ],
   "text": "Общежитие. Даже стены здесь шепчут о Первом Кошмаре."
  },
  {
   "id": "L015",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:canteen"
   ],
   "text": "Общий зал. Еда без боя — почти забыл, что так бывает."
  },
  {
   "id": "L016",
   "hero": "P04",
   "kind": "say",
   "when": [
    "at:yard"
   ],
   "text": "Тренировочный двор. Покажу, как держат клинок Наследники."
  },
  {
   "id": "L017",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:library"
   ],
   "text": "Библиотека. Тысячи книг, ни одной для меня — зато слышно, как шуршат страницы."
  },
  {
   "id": "L018",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:arena"
   ],
   "text": "Арена. Здесь я не проигрываю."
  },
  {
   "id": "L019",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:capsules"
   ],
   "text": "Зал капсул. Здесь засыпают, чтобы проснуться другими."
  },
  {
   "id": "L020",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:admin"
   ],
   "text": "Административный корпус. Самые опасные чудовища носят галстуки."
  },
  {
   "id": "L021",
   "hero": "P04",
   "kind": "say",
   "when": [
    "at:range"
   ],
   "text": "Полигон. Мишени хотя бы не кусаются."
  },
  {
   "id": "L022",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:lab"
   ],
   "text": "Лаборатория Кошмаров. Здесь держат то, что лучше бы забыть."
  },
  {
   "id": "L023",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:stone_isle"
   ],
   "text": "Каменная платформа. Здесь всё началось: чёрная вода и ни одной звезды."
  },
  {
   "id": "L024",
   "hero": "*",
   "kind": "say",
   "when": [
    "at:low_tide"
   ],
   "text": "Отмель. Пока вода ушла — идём. Вернётся — бежим."
  },
  {
   "id": "L025",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:coral_maze"
   ],
   "text": "Багровый лабиринт. Кораллы режут, как ножи, и растут, как сорняки."
  },
  {
   "id": "L026",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:shelter"
   ],
   "text": "Расщелина-укрытие. Здесь можно спать. Почти спокойно."
  },
  {
   "id": "L027",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:drowned_hall"
   ],
   "text": "Затопленный зал. Его строили для вечности. Море не согласилось."
  },
  {
   "id": "L028",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:spire_view"
   ],
   "text": "Отсюда виден Шпиль. И, кажется, он видит нас."
  },
  {
   "id": "L029",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:statue_hill"
   ],
   "text": "Холм у статуи. Камень помнит лицо, которое все забыли."
  },
  {
   "id": "L030",
   "hero": "P02",
   "kind": "say",
   "when": [
    "at:high_ground"
   ],
   "text": "Высота. Отсюда видно, откуда придёт вода — и кто придёт с ней."
  },
  {
   "id": "L031",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:hunting_grounds"
   ],
   "text": "Охотничьи коридоры. Вопрос только в том, кто здесь охотник."
  },
  {
   "id": "L032",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:centurion_gate"
   ],
   "text": "Коралловые врата. За ними что-то тяжело дышит."
  },
  {
   "id": "L033",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:legion_ruins"
   ],
   "text": "Обломки Легиона. Целая армия — и осталась только ржавчина."
  },
  {
   "id": "L034",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:leviathan_ribs"
   ],
   "text": "Рёбра Левиафана. Надеюсь, он за ними не вернётся."
  },
  {
   "id": "L035",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:sunken_watch"
   ],
   "text": "Затонувший дозор. Они стерегли берег до конца. Берег их не запомнил."
  },
  {
   "id": "L036",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:carapace_nest"
   ],
   "text": "Гнездовье… Слышите? Там что-то щёлкает."
  },
  {
   "id": "L037",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:strangers_camp"
   ],
   "text": "Чужой лагерь. Зола ещё тёплая. Хозяева недалеко — или уже нигде."
  },
  {
   "id": "L038",
   "hero": "*",
   "kind": "say",
   "when": [
    "at:whale_carcass"
   ],
   "text": "Туша исполина. Даже падальщики думают дважды."
  },
  {
   "id": "L039",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:tide_grotto"
   ],
   "text": "Грот отлива. Вода ушла и оставила свои секреты."
  },
  {
   "id": "L040",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:fallen_star"
   ],
   "text": "Звёздный осколок. Свет, упавший с неба, всё ещё горит."
  },
  {
   "id": "L041",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:legion_well"
   ],
   "text": "Колодец Легиона. Бросишь камень — и долго ждёшь звука."
  },
  {
   "id": "L042",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:sleeping_golem"
   ],
   "text": "Спящий голем. Давайте все договоримся его не будить."
  },
  {
   "id": "L043",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:messenger_nest"
   ],
   "text": "Гнездо посланника. Крылья шуршат, как письма."
  },
  {
   "id": "L044",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:centipede_lair"
   ],
   "text": "Логово многоножек. У меня всего две ноги. Это нечестно."
  },
  {
   "id": "L045",
   "hero": "P02",
   "kind": "say",
   "when": [
    "at:sleepers_graves"
   ],
   "text": "Могилы Спящих. Мы их помним. Этого мало, но это всё, что мы можем."
  },
  {
   "id": "L046",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:stranded_islet"
   ],
   "text": "Островок отрезанных. Вода вокруг — как стены тюрьмы."
  },
  {
   "id": "L047",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:shore_exit"
   ],
   "text": "Выход с Берега. Не думал, что буду скучать по этим кораллам."
  },
  {
   "id": "L048",
   "hero": "P02",
   "kind": "say",
   "when": [
    "at:ash_dunes"
   ],
   "text": "Пепельные дюны. След держится, пока нет ветра. Не отставайте."
  },
  {
   "id": "L049",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:ash_bones"
   ],
   "text": "Кости в пепле. Кто-то шёл туда же, куда и мы."
  },
  {
   "id": "L050",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:ash_lord"
   ],
   "text": "Логово Владыки Пепла. Говорите шёпотом и думайте ещё тише."
  },
  {
   "id": "L051",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:stone_hulk"
   ],
   "text": "Каменный остов. Внутри пусто, но эхо ещё говорит."
  },
  {
   "id": "L052",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:demon_trail"
   ],
   "text": "Тропа Демона. Следы свежие. Не оглядываться."
  },
  {
   "id": "L053",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:death_beacon"
   ],
   "text": "Маяк смерти. Свет, который зовёт не к спасению."
  },
  {
   "id": "L054",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:abyss_bridge"
   ],
   "text": "Мост над Бездной. Правило первое: не смотреть вниз. Второе: см. первое."
  },
  {
   "id": "L055",
   "hero": "*",
   "kind": "wisdom",
   "when": [
    "at:abyss_edge"
   ],
   "text": "На краю Бездны понимаешь, как мало в нас уверенности — и как её хватает."
  },
  {
   "id": "L056",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:lake_shore"
   ],
   "text": "Чёрная вода. Она слушает нас так же, как я — её."
  },
  {
   "id": "L057",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:soul_tree"
   ],
   "text": "Древо Души поёт. Только бы никто не начал подпевать."
  },
  {
   "id": "L058",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:boat_cove"
   ],
   "text": "Лодочная заводь. Лодка — мост, который можно взять с собой."
  },
  {
   "id": "L059",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:deep_maw"
   ],
   "text": "Пасть недр. Даже ветер не хочет заходить внутрь."
  },
  {
   "id": "L060",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:star_landing"
   ],
   "text": "Звёздный берег. Конец пути — или начало следующего."
  },
  {
   "id": "L061",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:glowing_moss"
   ],
   "text": "Светящийся мох. Тёплый. Будто кто-то оставил нам ночник."
  },
  {
   "id": "L062",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:bright_castle"
   ],
   "text": "Светлый замок. Слишком много света для этого города."
  },
  {
   "id": "L063",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:castle_gate"
   ],
   "text": "Ворота замка. Платим дань — или ночуем с теми, кто не платит."
  },
  {
   "id": "L064",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:memory_market"
   ],
   "text": "Рынок Воспоминаний. Торгуют памятью. Свою не продавайте."
  },
  {
   "id": "L065",
   "hero": "P04",
   "kind": "say",
   "when": [
    "at:hunters_guild"
   ],
   "text": "Гильдия охотников. Наконец-то здесь ценят хороший удар."
  },
  {
   "id": "L066",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "at:statue_plaza"
   ],
   "text": "Площадь статуй. Все смотрят в одну сторону. Туда лучше не смотреть."
  },
  {
   "id": "L067",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:ruined_cathedral"
   ],
   "text": "Разрушенный собор. Здесь молились. Теперь здесь охотятся."
  },
  {
   "id": "L068",
   "hero": "*",
   "kind": "wisdom",
   "when": [
    "at:graveyard_hope"
   ],
   "text": "Кладбище надежд. Хорошо, что свою я ношу с собой."
  },
  {
   "id": "L069",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:dark_well"
   ],
   "text": "Тёмный колодец. Тени здесь гуще моих. Даже обидно."
  },
  {
   "id": "L070",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:sunny_lair"
   ],
   "text": "Логово в башне. Своё. Первый раз в жизни у меня есть своё."
  },
  {
   "id": "L071",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:harbour"
   ],
   "text": "Нижняя гавань. Корабли давно ушли, а вода всё ждёт."
  },
  {
   "id": "L072",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:canals"
   ],
   "text": "Каналы. Вода течёт медленно, будто боится шуметь."
  },
  {
   "id": "L073",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:catacombs"
   ],
   "text": "Катакомбы. Где-то внизу этот город прячет своё сердце."
  },
  {
   "id": "L074",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:lighthouse"
   ],
   "text": "Маяк на утёсе. Свет для тех, кто ещё ищет дорогу."
  },
  {
   "id": "L075",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:outskirts"
   ],
   "text": "Окраины. Здесь я вырос. Здесь меня никто не ждёт."
  },
  {
   "id": "L076",
   "hero": "P03",
   "kind": "say",
   "when": [
    "at:hospital"
   ],
   "text": "Госпиталь. Здесь стонут не чудовища, а люди. Это тяжелее."
  },
  {
   "id": "L077",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:metro_hub"
   ],
   "text": "Узел подземки. Темнота под городом — совсем как в Кошмаре."
  },
  {
   "id": "L078",
   "hero": "P02",
   "kind": "say",
   "when": [
    "at:bunker"
   ],
   "text": "Убежище. Пока мы здесь, у людей есть стены."
  },
  {
   "id": "L079",
   "hero": "P01",
   "kind": "say",
   "when": [
    "at:market"
   ],
   "text": "Рынок. Цены выросли. Конец света — отличное время для торговли."
  },
  {
   "id": "L080",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "at:bridges"
   ],
   "text": "Мосты. Разрушить легко. Удержать — вот работа."
  },
  {
   "id": "L081",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:wall"
   ],
   "text": "Стена периметра. Последняя черта между людьми и Кошмаром."
  },
  {
   "id": "L082",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "at:academy_link"
   ],
   "text": "Дорога в Академию. Когда-то я не знал, что меня ждёт. Теперь знаю. Хуже."
  },
  {
   "id": "L083",
   "hero": "*",
   "kind": "thought",
   "when": [
    "at:old_center"
   ],
   "text": "Старый центр. Даже руины здесь помнят праздники."
  },
  {
   "id": "L084",
   "hero": "*",
   "kind": "thought",
   "when": [
    "story"
   ],
   "text": "{story_place}. Чувствую, там ждут именно нас."
  },
  {
   "id": "L085",
   "hero": "P02",
   "kind": "say",
   "when": [
    "story"
   ],
   "text": "Главное сейчас — {story_place}. Остальное подождёт."
  },
  {
   "id": "L086",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "story"
   ],
   "text": "Мне снится {story_place}. Каждую ночь — чуть ближе."
  },
  {
   "id": "L087",
   "hero": "P01",
   "kind": "say",
   "when": [
    "story"
   ],
   "text": "{story_place}. Разумные люди от таких мест бегут. Мы, конечно, пойдём."
  },
  {
   "id": "L088",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "story:MS02"
   ],
   "text": "Цепи натирают. Хорошо: значит, я ещё чувствую руки."
  },
  {
   "id": "L089",
   "hero": "P08",
   "kind": "say",
   "when": [
    "story:MS05"
   ],
   "text": "Горный Король не спит. Значит, и мы не будем."
  },
  {
   "id": "L090",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "done:MS07"
   ],
   "text": "Шифти больше нет. Я не жалею. И это пугает сильнее всего."
  },
  {
   "id": "L091",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "story:MS10"
   ],
   "text": "Храм ждёт. И тени тянутся к нему вместе со мной."
  },
  {
   "id": "L092",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "story:MA12"
   ],
   "text": "Белый потолок. Последнее, что я ждал увидеть после Кошмара."
  },
  {
   "id": "L093",
   "hero": "P04",
   "kind": "say",
   "when": [
    "story:MA16"
   ],
   "text": "Сегодня Академия увидит, на что способен Наследник."
  },
  {
   "id": "L094",
   "hero": "P04",
   "kind": "thought",
   "when": [
    "done:MA16"
   ],
   "text": "Это был учебный бой. Учебный."
  },
  {
   "id": "L095",
   "hero": "*",
   "kind": "thought",
   "when": [
    "story:MA18"
   ],
   "text": "Солнцестояние. Скоро нас отправят туда, откуда не возвращаются."
  },
  {
   "id": "L096",
   "hero": "P01",
   "kind": "say",
   "when": [
    "story:SH19"
   ],
   "text": "Чёрное море и камень под ногами. Отличное начало."
  },
  {
   "id": "L097",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "story:SH21"
   ],
   "text": "Падальщик Карапакса. Панцирь как стена. Значит, бить туда, где стены нет."
  },
  {
   "id": "L098",
   "hero": "P03",
   "kind": "say",
   "when": [
    "story:SH25"
   ],
   "text": "Мне снился сон. Я расскажу… когда пойму, что он значит."
  },
  {
   "id": "L099",
   "hero": "P01",
   "kind": "say",
   "when": [
    "story:SH27"
   ],
   "text": "Шторм идёт. Прекрасно: давно мечтал промокнуть насмерть."
  },
  {
   "id": "L100",
   "hero": "P02",
   "kind": "thought",
   "when": [
    "story:SH29"
   ],
   "text": "Пламя помнит, кто я. Даже когда я сама сомневаюсь."
  },
  {
   "id": "L101",
   "hero": "P03",
   "kind": "thought",
   "when": [
    "story:SH30"
   ],
   "text": "Пророчество тяжёлое. Я несу его за всех — и никому не могу отдать."
  },
  {
   "id": "L102",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "story:SH32"
   ],
   "text": "Шпиль смотрит на нас не первую неделю. Пора посмотреть в ответ."
  },
  {
   "id": "L103",
   "hero": "P01",
   "kind": "thought",
   "when": [
    "story:TS04"
   ],
   "text": "Шаги позади. Не оглядываться. Просто не оглядываться."
  },
  {
   "id": "L104",
   "hero": "P03",
   "kind": "say",
   "when": [
    "story:TS09"
   ],
   "text": "Древо зовёт. Держите меня за руку, если я пойду на голос."
  },
  {
   "id": "L105",
   "hero": "P01",
   "kind": "say",
   "when": [
    "story:TS12"
   ],
   "text": "Лодка! Наконец-то что-то здесь не хочет нас съесть."
  },
  {
   "id": "L106",
   "hero": "P02",
   "kind": "say",
   "when": [
    "story:TS14"
   ],
   "text": "Звёздный берег близко. Последний рывок."
  },
  {
   "id": "L107",
   "hero": "P01",
   "kind": "say",
   "when": [
    "story:DS02"
   ],
   "text": "Своя башня. Звучит как мечта, выглядит как ловушка."
